// SOL-specific NextNEOpi execution configuration
// TCGA-BRCA full 80-patient cohort

params {
    tmpDir = '/scratch/vnikoone/01_ARPA/02_TCGA/03_BRCA/02_immunogenomics/07_BRCA_NextNEOpi/07_full_80_cohort/05_tmp'

    outputDir = '/scratch/vnikoone/01_ARPA/02_TCGA/03_BRCA/02_immunogenomics/07_BRCA_NextNEOpi/07_full_80_cohort/03_results'

    MIXCR_lic = '/scratch/vnikoone/999_envs/licenses/MiXCR_License.txt'

}

process {
    executor = 'slurm'
    
    // Limit concurrently executing processes for the full cohort.
    maxForks = 60
    
    // Resource overrides validated during the four-patient pilot.
    // Original NextNEOpi configuration remains unchanged.

    withName: bam2fastq {
        memory = '196 G'
    }

    withName: installVEPcache {
        time = '12 h'
    }

    withName: 'OptiType.*' {
        memory = '128 G'
        time = '24 h'
    }

    withName: Mutect2 {
    errorStrategy = { task.exitStatus == 255 ? 'retry' : (task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish') }
    maxRetries = 2
    }

    withName: Neofuse {
    containerOptions = '--bind /scratch/vnikoone/01_ARPA/02_TCGA/03_BRCA/02_immunogenomics/07_BRCA_NextNEOpi/07_full_80_cohort/06_NeoFuse_final_out_patched.py:/usr/local/bin/source/final_out.py:ro'
    }

    withName: MarkDuplicates {
    maxForks = 2
    errorStrategy = { task.exitStatus in [137, 143, 255] ? 'retry' : 'terminate' }
    maxRetries = 2
    }

    withName: 'mixcr' {
    errorStrategy = { task.exitStatus == 24 ? 'retry' : 'terminate' }
    maxRetries = 2
    }

    withName: 'merge_uBAM_BAM' {
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'pVACseq' {
    containerOptions = '--bind /scratch/vnikoone/01_ARPA/02_TCGA/03_BRCA/02_immunogenomics/07_BRCA_NextNEOpi/07_full_80_cohort/07_netmhc_stab_timeout60.py:/opt/conda/lib/python3.11/site-packages/pvactools/lib/netmhc_stab.py:ro'
    errorStrategy = { task.exitStatus == 1 ? 'retry' : 'terminate' }
    maxRetries = 2
    }
}

executor {
queueSize = 200
}

workDir = '/scratch/vnikoone/01_ARPA/02_TCGA/03_BRCA/02_immunogenomics/07_BRCA_NextNEOpi/07_full_80_cohort/04_work'
